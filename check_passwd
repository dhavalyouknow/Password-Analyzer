import re
import random
import string

def password_strength(password):
    score = 0
    suggestions = []

    # Length check
    if len(password) >= 8:
        score += 1
    else:
        suggestions.append("Use at least 8 characters")

    # Uppercase & lowercase
    if re.search(r'[A-Z]', password) and re.search(r'[a-z]', password):
        score += 1
    else:
        suggestions.append("Mix uppercase and lowercase letters")

    # Digits
    if re.search(r'\d', password):
        score += 1
    else:
        suggestions.append("Add at least one number")

    # Special characters
    if re.search(r'[@$!%*?&]', password):
        score += 1
    else:
        suggestions.append("Include a special character (@, $, %, &, etc.)")

    # Strength levels
    if score == 4:
        return "Strong ✅", suggestions
    elif score == 3:
        return "Medium ⚠️", suggestions
    else:
        return "Weak ❌", suggestions

def generate_password(length=12):
    chars = string.ascii_letters + string.digits + "!@#$%^&*()"
    return ''.join(random.choice(chars) for _ in range(length))

# Demo
password = "Pass123"
strength, tips = password_strength(password)
print(f"Password: {password}")
print(f"Strength: {strength}")
print("Suggestions:", tips)
print("Auto-Suggested Strong Password:", generate_password())
